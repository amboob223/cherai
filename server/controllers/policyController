const pool = require("../db");
const logAction = require("../helpers/logHelper");

// GET all policies
const getPolicies = async (req, res) => {
  try {
    const result = await pool.query("SELECT * FROM policies");
    res.json(result.rows);
  } catch (err) {
    res.status(500).send("Server error");
  }
};

// GET single policy by ID
const getPolicyById = async (req, res) => {
  try {
    const { id } = req.params;
    const result = await pool.query("SELECT * FROM policies WHERE id = $1", [id]);
    res.json(result.rows[0]);
  } catch (err) {
    res.status(500).send("Server error");
  }
};

// CREATE policy
const createPolicy = async (req, res) => {
  try {
    const { title, description } = req.body;

    const result = await pool.query(
      `INSERT INTO policies (title, description)
       VALUES ($1, $2)
       RETURNING *`,
      [title, description]
    );

    const newPolicy = result.rows[0];

    // AUDIT LOG
    await logAction(
      req.user.userId,
      "CREATE_POLICY",
      "policy",
      newPolicy.id
    );

    res.status(201).json(newPolicy);

  } catch (err) {
    console.error(err.message);
    res.status(500).send("Server error");
  }
};

